// The configuration local-e2e serves (runtime/tests/integration/local_server/).
// Most workers have one route; the two realm workers have two each, to
// compare a realm per route with one realm shared by every route of a
// worker. The harness chooses the listener, the certificate and the
// analytics directory itself, so none is set here.
//
// api/todos.js is an Elysia API and api/hono.js a Hono app, each bundled by
// Bun into one module; the opt-in benchmarks measure them as real module
// graphs. api/lazy.js reaches api/lib/lazy_value.js only through import().
// api/token.js and api/upload.js answer with a token drawn once per worker
// process, which tells the worker tests whether two responses came from one
// worker.
//
// No definition here grants `network`, so no worker of this file has an
// egress session and the server spawns no gateway for it. The tests that
// fetch write a configuration whose grant names their origin's run-time
// address (local_server/network.zig, `configText`), and use the handlers
// api/fetch_gzip.js, api/network_fetch.js and api/network_no_grant.js. The
// tests of a definition's limits (local_server/limits.zig) and of workers that
// retire under load (local_server/workers.zig) write theirs with the same
// template, around api/finalization_spin.js, api/memory_grow.js and
// api/boot_rejects.js beside the handlers of this file.
{
  "globalSettings": {
    "limits": { "memoryMiB": 1024, "timeoutMs": 15000 }
  },
  "workers": {
    "hello": {
      "routes": {
        "/hello/:name": { "entry": "./api/hello.js", "bindings": { "GREETING": { "text": "hello" } } }
      }
    },
    "echo": {
      "routes": { "/echo": { "entry": "./api/echo.js" } }
    },
    "env": {
      "routes": {
        "/env": { "entry": "./api/env.js", "bindings": { "TOKEN": { "text": "e2e-token" } } }
      }
    },
    // The two hanging routes need a deadline short enough for a test.
    "hang-before": {
      "routes": { "/hang-before": { "entry": "./api/hang_before.js" } },
      "settings": { "limits": { "timeoutMs": 1000 } }
    },
    "hang-sync": {
      "routes": { "/hang-sync": { "entry": "./api/hang_sync.js" } },
      "settings": { "limits": { "timeoutMs": 1000 } }
    },
    "large-response": {
      "routes": { "/large-response": { "entry": "./api/large_response.js" } }
    },
    "todos": {
      "routes": { "/api/todos": { "entry": "./api/todos.js" } }
    },
    "hono": {
      "routes": { "/api/hono": { "entry": "./api/hono.js" } }
    },
    "lazy": {
      "routes": { "/lazy": { "entry": "./api/lazy.js" } }
    },
    // Two requests share one worker of each of these, which the worker tests
    // rely on, and the deadline route's requests time out within a test.
    "token": {
      "routes": { "/token": { "entry": "./api/token.js" } },
      "settings": { "limits": { "concurrency": 2 } }
    },
    "deadline": {
      "routes": { "/deadline": { "entry": "./api/token.js" } },
      "settings": { "limits": { "concurrency": 2, "timeoutMs": 1000 } }
    },
    "upload": {
      "routes": { "/upload": { "entry": "./api/upload.js" } },
      "settings": { "limits": { "concurrency": 2 } }
    },
    // Streamed bodies (local_server/streams.zig): a request that follows a
    // stream on its connection takes the worker's other slot while the lane
    // still drains the first one's completion.
    "stream": {
      "routes": { "/stream": { "entry": "./api/stream.js" } },
      "settings": { "limits": { "concurrency": 2, "timeoutMs": 10000 } }
    },
    // Two routes on one entry, each with its own binding, served by one
    // worker: in a realm each (the default), or in one shared realm.
    "realms-isolated": {
      "routes": {
        "/realms/isolated/a": { "entry": "./api/realm_probe.js", "bindings": { "ROUTE": { "text": "a" } } },
        "/realms/isolated/b": { "entry": "./api/realm_probe.js", "bindings": { "ROUTE": { "text": "b" } } }
      },
      "settings": { "isolateRealm": true }
    },
    "realms-shared": {
      "routes": {
        "/realms/shared/a": { "entry": "./api/realm_probe.js", "bindings": { "ROUTE": { "text": "a" } } },
        "/realms/shared/b": { "entry": "./api/realm_probe.js", "bindings": { "ROUTE": { "text": "b" } } }
      },
      "settings": { "isolateRealm": false }
    }
  }
}
