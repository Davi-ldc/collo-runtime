+static unsigned
+parse_u32_arg (const char *s, const char *name)
+{
+    char *end;
+    unsigned long v;
+    const char *p;
+
+    if (*s == '\0')
+        goto err;
+    for (p = s; *p; ++p)
+        if (*p < '0' || *p > '9')
+            goto err;
+
+    errno = 0;
+    v = strtoul(s, &end, 10);
+    if (errno != 0 || *end != '\0' || v > UINT_MAX)
+        goto err;
+
+    return (unsigned) v;
+
+  err:
+    fprintf(stderr, "invalid %s: %s\n", name, s);
+    exit(EXIT_FAILURE);
+}
+
+
+static int
+parse_sensitive_policy (const char *policy, enum sensitive_policy *out)
+{
+    if (0 == strcmp(policy, "none"))
+        *out = SENSITIVE_NONE;
+    else if (0 == strcmp(policy, "auth"))
+        *out = SENSITIVE_AUTH_ONLY;
+    else if (0 == strcmp(policy, "set-cookie")
+        || 0 == strcmp(policy, "auth-and-set-cookie"))
+        *out = SENSITIVE_AUTH_AND_SET_COOKIE;
+    else if (0 == strcmp(policy, "cookies"))
+        *out = SENSITIVE_ALL_COOKIES;
+    else
+        return -1;
+    return 0;
+}
