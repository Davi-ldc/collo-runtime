diff --git a/bin/test-encode-qif-policy.sh b/bin/test-encode-qif-policy.sh
--- a/bin/test-encode-qif-policy.sh
+++ b/bin/test-encode-qif-policy.sh
@@ -0,0 +1,125 @@
+#!/bin/sh
+set -eu
+
+if [ "$#" -ne 1 ]; then
+    echo "usage: $0 /path/to/encode-qif" >&2
+    exit 2
+fi
+
+encode_qif="$1"
+tmp_dir="${TMPDIR:-/tmp}/lshpack-encode-qif-policy-test.$$"
+mkdir -p "$tmp_dir"
+trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
+
+qif="$tmp_dir/input.qif"
+cat >"$qif" <<'QIF'
+:method	GET
+:scheme	https
+:authority	demo.example.test
+:path	/alpha
+authorization	Bearer abc
+set-cookie	sid=abc; HttpOnly
+cookie	a=1; b=2
+
+:method	GET
+:scheme	https
+:authority	demo.example.test
+:path	/beta
+authorization	Bearer abc
+set-cookie	sid=abc; HttpOnly
+cookie	a=1; b=2
+
+QIF
+
+run_policy() {
+    policy="$1"
+    output="$2"
+    if [ "$policy" = "default" ]; then
+        "$encode_qif" -i "$qif" -n 2 >"$output"
+    else
+        "$encode_qif" -i "$qif" -n 2 -s "$policy" >"$output"
+    fi
+}
+
+none_out="$tmp_dir/none.hpack"
+auth_out="$tmp_dir/auth.hpack"
+default_out="$tmp_dir/default.hpack"
+auth_set_cookie_out="$tmp_dir/auth-set-cookie.hpack"
+alias_out="$tmp_dir/alias.hpack"
+cookies_out="$tmp_dir/cookies.hpack"
+
+run_policy none "$none_out"
+run_policy auth "$auth_out"
+run_policy default "$default_out"
+run_policy auth-and-set-cookie "$auth_set_cookie_out"
+run_policy set-cookie "$alias_out"
+run_policy cookies "$cookies_out"
+
+if ! cmp -s "$default_out" "$none_out"; then
+    echo "default policy must match none" >&2
+    exit 1
+fi
+
+if ! cmp -s "$auth_set_cookie_out" "$alias_out"; then
+    echo "set-cookie alias must match auth-and-set-cookie policy" >&2
+    exit 1
+fi
+
+default_size="$(wc -c <"$default_out")"
+auth_size="$(wc -c <"$auth_out")"
+auth_set_cookie_size="$(wc -c <"$auth_set_cookie_out")"
+cookies_size="$(wc -c <"$cookies_out")"
+
+if [ "$default_size" -ge "$auth_size" ]; then
+    echo "auth policy should emit more bytes than default: default=$default_size auth=$auth_size" >&2
+    exit 1
+fi
+if [ "$auth_size" -ge "$auth_set_cookie_size" ]; then
+    echo "auth-and-set-cookie policy should emit more bytes than auth: auth=$auth_size auth-set-cookie=$auth_set_cookie_size" >&2
+    exit 1
+fi
+if [ "$auth_set_cookie_size" -ge "$cookies_size" ]; then
+    echo "cookies policy should emit more bytes than auth-and-set-cookie: auth-set-cookie=$auth_set_cookie_size cookies=$cookies_size" >&2
+    exit 1
+fi
+
+if "$encode_qif" -i "$qif" -n 1 -s bogus >/dev/null 2>&1; then
+    echo "unknown sensitive policy should fail" >&2
+    exit 1
+fi
+
+if "$encode_qif" -i "$qif" -n 1 -t -1 >/dev/null 2>&1; then
+    echo "negative dynamic table size should fail" >&2
+    exit 1
+fi
+
+if "$encode_qif" -i "$qif" -n 1 -t notanumber >/dev/null 2>&1; then
+    echo "non-numeric dynamic table size should fail" >&2
+    exit 1
+fi
+
+if "$encode_qif" -i "$qif" -n ' -1' >/dev/null 2>&1; then
+    echo "signed/space-prefixed iteration count should fail" >&2
+    exit 1
+fi
+
+long_qif="$tmp_dir/long.qif"
+awk 'BEGIN {
+    printf "x-long\t";
+    for (i = 0; i < 70000; ++i)
+        printf "a";
+    printf "\n\n";
+}' >"$long_qif"
+
+if "$encode_qif" -i "$long_qif" -n 1 >/dev/null 2>&1; then
+    echo "oversized header should fail" >&2
+    exit 1
+fi
+
+no_final_blank_qif="$tmp_dir/no-final-blank.qif"
+printf ':method	GET
+:path	/no-final-blank' >"$no_final_blank_qif"
+
+"$encode_qif" -i "$no_final_blank_qif" -n 1 >/dev/null
+
+exit 0
