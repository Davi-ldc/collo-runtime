+    assert(henc.hpe_hist_buf[2] == 0xC);
+    assert(henc.hpe_hist_idx == 3);
+    assert(!henc.hpe_hist_wrapped);
+
+    henc.hpe_hist_buf[henc.hpe_hist_idx] = 0xD;
+    henc.hpe_hist_idx = (henc.hpe_hist_idx + 1) % henc.hpe_hist_size;
+    henc.hpe_hist_wrapped |= henc.hpe_hist_idx == 0;
+
+    lshpack_enc_set_max_capacity(&henc, 192);
+    assert(henc.hpe_hist_size == 2);
+    assert(henc.hpe_hist_buf[0] == 0xC);
+    assert(henc.hpe_hist_buf[1] == 0xD);
+    assert(henc.hpe_hist_idx == 0);
+    assert(henc.hpe_hist_wrapped);
+    lshpack_enc_cleanup(&henc);
+}
