+static void
+header_precompute_metadata (struct header *header,
+                            enum sensitive_policy policy)
+{
+    lsxpack_header_t tmp;
+    const size_t val_offset = (size_t) (header->val - header->name);
+    const unsigned sensitive_flags = sensitive_flags_for_name(
+        header->name, header->name_len, policy);
+    const unsigned precompute_flags = sensitive_flags & LSXPACK_NEVER_INDEX
+        ? LSHPACK_ENC_PRECOMPUTE_NAME_ONLY : LSHPACK_ENC_PRECOMPUTE_FULL;
+
+    lsxpack_header_set_offset2(&tmp, header->name, 0, header->name_len,
+                               val_offset, header->val_len);
+    (void) lshpack_enc_precompute_static(&tmp, precompute_flags);
+    header->name_hash = tmp.flags & LSXPACK_NAME_HASH ? tmp.name_hash : 0;
+    header->nameval_hash = tmp.flags & LSXPACK_NAMEVAL_HASH
+        ? tmp.nameval_hash : 0;
+    header->hpack_nameval_index = tmp.flags & LSXPACK_HPACK_VAL_MATCHED
+        ? tmp.hpack_index : 0;
+    header->hpack_name_index = tmp.hpack_index;
+    header->flags = (tmp.flags & (LSXPACK_NAME_HASH | LSXPACK_NAMEVAL_HASH))
+        | sensitive_flags;
+}
