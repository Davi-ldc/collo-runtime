+static void
+test_hpack_skips_oversized_dynamic_entries (void)
+{
+    struct lshpack_enc henc;
+    struct lshpack_dec hdec;
+    struct lsxpack_header xhdr;
+    char small[] = "smallnamevalue";
+    char large[] = "large-nameaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+                   "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+    int rc;
+
+    rc = lshpack_enc_init(&henc);
+    assert(rc == 0);
+    lshpack_enc_set_max_capacity(&henc, 64);
+    lsxpack_header_set_offset2(&xhdr, small, 0, 5, 5, 9);
+    (void) lshpack_enc_precompute_static(&xhdr, LSHPACK_ENC_PRECOMPUTE_FULL);
+    rc = lshpack_enc_push_entry(&henc, &xhdr);
+    assert(rc == 0);
+    assert(henc.hpe_nelem == 1);
+    assert(henc.hpe_cur_capacity > 0);
+
+    lsxpack_header_set_offset2(&xhdr, large, 0, 10, 10, sizeof(large) - 11);
+    (void) lshpack_enc_precompute_static(&xhdr, LSHPACK_ENC_PRECOMPUTE_FULL);
+    rc = lshpack_enc_push_entry(&henc, &xhdr);
+    assert(rc == 0);
+    assert(henc.hpe_nelem == 0);
+    assert(henc.hpe_cur_capacity == 0);
+    lshpack_enc_cleanup(&henc);
+
+    lshpack_dec_init(&hdec);
+    lshpack_dec_set_max_capacity(&hdec, 64);
+    lsxpack_header_set_offset2(&xhdr, small, 0, 5, 5, 9);
+    rc = lshpack_dec_push_entry(&hdec, &xhdr);
+    assert(rc == 0);
+    assert(hdec.hpd_dyn_table.nelem == 1);
+    assert(hdec.hpd_cur_capacity > 0);
+
+    lsxpack_header_set_offset2(&xhdr, large, 0, 10, 10, sizeof(large) - 11);
+    rc = lshpack_dec_push_entry(&hdec, &xhdr);
+    assert(rc == 0);
+    assert(hdec.hpd_dyn_table.nelem == 0);
+    assert(hdec.hpd_cur_capacity == 0);
+    lshpack_dec_cleanup(&hdec);
+}
