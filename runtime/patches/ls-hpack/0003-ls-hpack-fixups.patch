+static void
+test_henc_resize_empty_history_not_wrapped (void)
+{
+    struct lshpack_enc henc;
+    unsigned default_hist_size, expanded_hist_size;
+    int rc;
+
+    rc = lshpack_enc_init(&henc);
+    assert(rc == 0);
+    rc = lshpack_enc_use_hist(&henc, 1);
+    assert(rc == 0);
+    default_hist_size = henc.hpe_hist_size;
+    lshpack_enc_set_max_capacity(&henc, 65536);
+    assert(henc.hpe_hist_size > default_hist_size);
+    assert(henc.hpe_hist_idx == 0);
+    assert(!henc.hpe_hist_wrapped);
+    lshpack_enc_cleanup(&henc);
+
+    rc = lshpack_enc_init(&henc);
