+static unsigned
+sensitive_flags_for_name (const char *name, size_t name_len,
+                          enum sensitive_policy policy)
+{
+    switch (policy)
+    {
+    case SENSITIVE_NONE:
+        return 0;
+    case SENSITIVE_AUTH_ONLY:
+        return HEADER_EQ(name, name_len, "authorization")
+            || HEADER_EQ(name, name_len, "proxy-authorization")
+                ? LSXPACK_NEVER_INDEX : 0;
+    case SENSITIVE_AUTH_AND_SET_COOKIE:
+        return HEADER_EQ(name, name_len, "authorization")
+            || HEADER_EQ(name, name_len, "proxy-authorization")
+            || HEADER_EQ(name, name_len, "set-cookie")
+                ? LSXPACK_NEVER_INDEX : 0;
+    case SENSITIVE_ALL_COOKIES:
+        return HEADER_EQ(name, name_len, "authorization")
+            || HEADER_EQ(name, name_len, "proxy-authorization")
+            || HEADER_EQ(name, name_len, "set-cookie")
+            || HEADER_EQ(name, name_len, "cookie")
+                ? LSXPACK_NEVER_INDEX : 0;
+    }
+    return 0;
+}
