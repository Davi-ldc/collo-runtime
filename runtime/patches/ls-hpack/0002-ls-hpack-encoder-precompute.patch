diff --git a/lshpack.h b/lshpack.h
--- a/lshpack.h
+++ b/lshpack.h
@@ -154,6 +154,22 @@
 lshpack_enc_encode (struct lshpack_enc *henc, unsigned char *dst,
         unsigned char *dst_end, struct lsxpack_header *input);
 
+#define LSHPACK_ENC_PRECOMPUTE_FULL       0x0
+#define LSHPACK_ENC_PRECOMPUTE_NAME_ONLY  0x1
+
+/**
+ * Precompute reusable HPACK encoder metadata on a header.
+ *
+ * FULL computes name and name/value hashes, finds static table matches, and
+ * marks exact static name/value matches with LSXPACK_HPACK_VAL_MATCHED.
+ * NAME_ONLY computes only name metadata and clears value-match metadata; use it
+ * with LSXPACK_NEVER_INDEX to avoid hashing large or sensitive values.
+ *
+ * Returns the matching HPACK static table index, or LSHPACK_HDR_UNKNOWN.
+ */
+unsigned
+lshpack_enc_precompute_static (struct lsxpack_header *, unsigned flags);
+
 void
 lshpack_enc_set_max_capacity (struct lshpack_enc *, unsigned);
 
