+static void
+test_henc_never_index_ignores_value_match (void)
+{
+    struct lshpack_enc henc;
+    struct lsxpack_header xhdr;
+    unsigned char out[0x100], *end;
+
+    lshpack_enc_init(&henc);
+    lsxpack_header_set_idx(&xhdr, LSHPACK_HDR_STATUS_200,
+                           STR_AND_LEN("200"));
+    xhdr.flags |= LSXPACK_NEVER_INDEX | LSXPACK_HPACK_VAL_MATCHED;
+    end = lshpack_enc_encode(&henc, out, out + sizeof(out), &xhdr);
+    assert(end > out);
+    assert((out[0] & 0x80) == 0);
+    assert((out[0] & 0xF0) == 0x10);
+    lshpack_enc_cleanup(&henc);
+}
+
+
+static void
+test_henc_never_index_rejects_bad_static_index (void)
+{
+    struct lshpack_enc henc;
+    struct lsxpack_header xhdr;
+    unsigned char out[0x100], *end;
+
+    lshpack_enc_init(&henc);
+    lsxpack_header_set_idx(&xhdr, 62, STR_AND_LEN("secret"));
+    xhdr.flags |= LSXPACK_NEVER_INDEX;
+    end = lshpack_enc_encode(&henc, out, out + sizeof(out), &xhdr);
+    assert(end == out);
+    lshpack_enc_cleanup(&henc);
+}
+
+
+static void
+test_henc_rejects_bad_static_index_without_never_index (void)
+{
+    struct lshpack_enc henc;
+    struct lsxpack_header xhdr;
+    unsigned char out[0x100], *end;
+
+    lshpack_enc_init(&henc);
+    lsxpack_header_set_idx(&xhdr, 62, STR_AND_LEN("value"));
+    end = lshpack_enc_encode(&henc, out, out + sizeof(out), &xhdr);
+    assert(end == out);
+
+    lsxpack_header_set_idx(&xhdr, 62, STR_AND_LEN("value"));
+    xhdr.flags |= LSXPACK_HPACK_VAL_MATCHED;
+    end = lshpack_enc_encode(&henc, out, out + sizeof(out), &xhdr);
+    assert(end == out);
+    lshpack_enc_cleanup(&henc);
+}
+
+
+static void
+test_henc_precompute_static_metadata (void)
+{
+    struct lsxpack_header xhdr;
+    char method[] = ":methodGET";
+    char auth[] = "authorizationBearer abc";
+    unsigned index;
+
+    lsxpack_header_set_offset2(&xhdr, method, 0, 7, 7, 3);
+    index = lshpack_enc_precompute_static(&xhdr,
+                                          LSHPACK_ENC_PRECOMPUTE_FULL);
+    assert(index == LSHPACK_HDR_METHOD_GET);
+    assert(xhdr.hpack_index == LSHPACK_HDR_METHOD_GET);
+    assert(xhdr.flags & LSXPACK_NAME_HASH);
+    assert(xhdr.flags & LSXPACK_NAMEVAL_HASH);
+    assert(xhdr.flags & LSXPACK_HPACK_VAL_MATCHED);
+
+    lsxpack_header_set_offset2(&xhdr, auth, 0, 13, 13, 10);
+    index = lshpack_enc_precompute_static(&xhdr,
+                                          LSHPACK_ENC_PRECOMPUTE_NAME_ONLY);
+    assert(index == LSHPACK_HDR_AUTHORIZATION);
+    assert(xhdr.hpack_index == LSHPACK_HDR_AUTHORIZATION);
+    assert(xhdr.flags & LSXPACK_NAME_HASH);
+    assert(!(xhdr.flags & LSXPACK_NAMEVAL_HASH));
+    assert(!(xhdr.flags & LSXPACK_HPACK_VAL_MATCHED));
+}
+
+
+static void
+test_henc_precompute_indexed_name_promotes_exact_static_value (void)
+{
+    static const struct {
+        unsigned name_index;
+        unsigned exact_index;
+        const char *value;
+        size_t value_len;
+        unsigned char encoded;
+    } cases[] = {
+        { LSHPACK_HDR_METHOD_GET, LSHPACK_HDR_METHOD_POST,
+          STR_AND_LEN("POST"), 0x83, },
+        { LSHPACK_HDR_PATH, LSHPACK_HDR_PATH_INDEX_HTML,
+          STR_AND_LEN("/index.html"), 0x85, },
+        { LSHPACK_HDR_SCHEME_HTTP, LSHPACK_HDR_SCHEME_HTTPS,
+          STR_AND_LEN("https"), 0x87, },
+        { LSHPACK_HDR_STATUS_200, LSHPACK_HDR_STATUS_404,
+          STR_AND_LEN("404"), 0x8D, },
+    };
+    struct lshpack_enc henc;
+    struct lsxpack_header xhdr;
+    unsigned char out[0x100], *end;
+    unsigned i, index;
+    int rc;
+
+    for (i = 0; i < sizeof(cases) / sizeof(cases[0]); ++i)
+    {
+        rc = lshpack_enc_init(&henc);
+        assert(rc == 0);
+        lsxpack_header_set_idx(&xhdr, cases[i].name_index,
+                               cases[i].value, cases[i].value_len);
+        index = lshpack_enc_precompute_static(&xhdr,
+                                              LSHPACK_ENC_PRECOMPUTE_FULL);
+        assert(index == cases[i].exact_index);
+        assert(xhdr.hpack_index == cases[i].exact_index);
+        assert(xhdr.flags & LSXPACK_NAME_HASH);
+        assert(xhdr.flags & LSXPACK_NAMEVAL_HASH);
+        assert(xhdr.flags & LSXPACK_HPACK_VAL_MATCHED);
+
+        end = lshpack_enc_encode(&henc, out, out + sizeof(out), &xhdr);
+        assert(end == out + 1);
+        assert(out[0] == cases[i].encoded);
+        assert(henc.hpe_nelem == 0);
+        lshpack_enc_cleanup(&henc);
+    }
+}
