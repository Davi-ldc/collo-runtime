+unsigned
+lshpack_enc_precompute_static (struct lsxpack_header *input, unsigned flags)
+{
+    const char *value;
+    unsigned candidate, id;
+
+    if (input->hpack_index > HPACK_STATIC_TABLE_SIZE)
+    {
+        input->hpack_index = LSHPACK_HDR_UNKNOWN;
+        input->flags &= ~LSXPACK_HPACK_VAL_MATCHED;
+    }
+
+    if (flags & LSHPACK_ENC_PRECOMPUTE_NAME_ONLY)
+    {
+        input->flags &= ~(LSXPACK_HPACK_VAL_MATCHED | LSXPACK_NAMEVAL_HASH);
+        if (input->hpack_index && input->name_len == 0)
+        {
+            id = input->hpack_index - 1;
+            input->name_hash = static_table_name_hash[id];
+            input->flags |= LSXPACK_NAME_HASH;
+            return input->hpack_index;
+        }
+        if (input->name_len == 0)
+            return LSHPACK_HDR_UNKNOWN;
+        update_name_hash(input);
+        input->hpack_index = lshpack_enc_get_static_name(input);
+        return input->hpack_index;
+    }
+
+    if (input->hpack_index && input->name_len == 0)
+    {
+        id = input->hpack_index - 1;
+        value = lsxpack_header_get_value(input);
+        input->name_hash = static_table_name_hash[id];
+        input->flags |= LSXPACK_NAME_HASH;
+        input->nameval_hash = XXH32(value, input->val_len, input->name_hash);
+        input->flags |= LSXPACK_NAMEVAL_HASH;
+        input->flags &= ~LSXPACK_HPACK_VAL_MATCHED;
+        candidate = (input->nameval_hash >> XXH_NAMEVAL_SHIFT)
+                  & ((1 << XXH_NAMEVAL_WIDTH) - 1);
+        if (nameval2id[candidate])
+        {
+            candidate = nameval2id[candidate] - 1;
+            if (static_table[candidate].name_len == static_table[id].name_len
+                && static_table[candidate].val_len == input->val_len
+                && 0 == memcmp(static_table[candidate].name,
+                               static_table[id].name,
+                               static_table[id].name_len)
+                && 0 == memcmp(value, static_table[candidate].val,
+                               input->val_len))
+            {
+                input->hpack_index = candidate + 1;
+                input->flags |= LSXPACK_HPACK_VAL_MATCHED;
+            }
+        }
+        return input->hpack_index;
+    }
+
+    if (input->name_len == 0)
+    {
+        input->flags &= ~(LSXPACK_HPACK_VAL_MATCHED | LSXPACK_NAMEVAL_HASH);
+        return LSHPACK_HDR_UNKNOWN;
+    }
+    update_hash(input);
+    input->hpack_index = lshpack_enc_get_static_nameval(input);
+    if (input->hpack_index != LSHPACK_HDR_UNKNOWN)
+    {
+        input->flags |= LSXPACK_HPACK_VAL_MATCHED;
+        return input->hpack_index;
+    }
+
+    input->flags &= ~LSXPACK_HPACK_VAL_MATCHED;
+    input->hpack_index = lshpack_enc_get_static_name(input);
+    return input->hpack_index;
+}
