diff --git a/test/test_hpack.c b/test/test_hpack.c
--- a/test/test_hpack.c
+++ b/test/test_hpack.c
@@ -633,6 +633,50 @@
 
 
 static void
+test_hdec_zero_length_indexed_name (void)
+{
+    const unsigned char literal[] = {
+        0x40,       /* Literal header field with incremental indexing: new name */
+        0x00,       /* Name length */
+        0x01, 'v',
+    };
+    const unsigned char indexed[] = {
+        0xBE,       /* First dynamic-table entry (static table has 61 entries) */
+    };
+    const unsigned char *src;
+    char out[0x100];
+    struct lshpack_dec hdec;
+    struct lsxpack_header xhdr;
+    int s;
+
+    lshpack_dec_init(&hdec);
+
+    src = literal;
+    lsxpack_header_prepare_decode(&xhdr, out, 0, sizeof(out));
+    s = lshpack_dec_decode(&hdec, &src, literal + sizeof(literal), &xhdr);
+    assert(0 == s);
+    assert(src == literal + sizeof(literal));
+    assert(0 == xhdr.name_len);
+    assert(1 == xhdr.val_len);
+    assert(NULL == lsxpack_header_get_name(&xhdr));
+    assert(0 == memcmp(lsxpack_header_get_value(&xhdr), "v", 1));
+    assert(1 == hdec.hpd_dyn_table.nelem);
+
+    src = indexed;
+    lsxpack_header_prepare_decode(&xhdr, out, 0, sizeof(out));
+    s = lshpack_dec_decode(&hdec, &src, indexed + sizeof(indexed), &xhdr);
+    assert(0 == s);
+    assert(src == indexed + sizeof(indexed));
+    assert(0 == xhdr.name_len);
+    assert(1 == xhdr.val_len);
+    assert(NULL == lsxpack_header_get_name(&xhdr));
+    assert(0 == memcmp(lsxpack_header_get_value(&xhdr), "v", 1));
+
+    lshpack_dec_cleanup(&hdec);
+}
+
+
+static void
 test_hdec_trailing_whitespace_name (void)
 {
     static const char name[] = "cookie \t\v\f\r\n";
@@ -1054,6 +1098,46 @@
 
 }
 
+static void
+test_hdec_missing_literal_value (void)
+{
+    static const unsigned char input[] = { 0x41, };
+    const unsigned char *src = input;
+    char out[0x100];
+    struct lshpack_dec hdec;
+    struct lsxpack_header xhdr;
+    int s;
+
+    lshpack_dec_init(&hdec);
+    lsxpack_header_prepare_decode(&xhdr, out, 0, sizeof(out));
+    s = lshpack_dec_decode(&hdec, &src, input + sizeof(input), &xhdr);
+    assert(s == LSHPACK_ERR_BAD_DATA);
+    assert(src == input);
+    lshpack_dec_cleanup(&hdec);
+}
+
+
+static void
+test_hdec_integer_overflow (void)
+{
+    static const unsigned char input[] = {
+        0xff, 0xff, 0xff, 0xff, 0xff, 0x7f,
+    };
+    const unsigned char *src = input;
+    char out[0x100];
+    struct lshpack_dec hdec;
+    struct lsxpack_header xhdr;
+    int s;
+
+    lshpack_dec_init(&hdec);
+    lsxpack_header_prepare_decode(&xhdr, out, 0, sizeof(out));
+    s = lshpack_dec_decode(&hdec, &src, input + sizeof(input), &xhdr);
+    assert(s == LSHPACK_ERR_BAD_DATA);
+    assert(src == input);
+    lshpack_dec_cleanup(&hdec);
+}
