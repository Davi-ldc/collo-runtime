+      0,                                                                 \
+      sha3_##bits##_init,                                                \
+      sha3_##bits##_update,                                              \
+      sha3_##bits##_final,                                               \
+      (block_bytes),                                                     \
+      sizeof(bssl::BORINGSSL_keccak_st),                                 \
+  };                                                                     \
+  const EVP_MD *EVP_sha3_##bits() { return &evp_md_sha3_##bits; }
