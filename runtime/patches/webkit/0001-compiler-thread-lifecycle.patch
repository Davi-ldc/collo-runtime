@@ -180,6 +180,16 @@ CompilationResult JITWorklist::enqueue(Ref<JITPlan> plan)
     return CompilationResult::CompilationDeferred;
 }
 
+void JITWorklist::startThreads()
+{
+    Locker locker { *m_lock };
+    // m_numberOfActiveThreads counts threads that have been woken and have not yet parked, and
+    // every wake through wakeThreads pairs its notify with an increment. Starting a thread outside
+    // that path still ends in a park, and JITWorklistThread::poll asserts the count is non-zero
+    // before decrementing it — so the increment has to happen here or the first poll crashes.
+    m_numberOfActiveThreads += m_planEnqueued->startAllThreads(locker);
+}
