+unsigned AutomaticThreadCondition::startAllThreads(const AbstractLocker& locker)
+{
+    // No notify: the threads have nothing to do yet. Each one polls, gets PollResult::Wait, and
+    // parks. Skipping the ones that already have a thread keeps this idempotent, and skipping the
+    // ones that stopped permanently is required — start() asserts on m_isRunning, and a thread that
+    // returned PollResult::Stop is indistinguishable from a retired one by hasUnderlyingThread.
+    unsigned started = 0;
+    for (auto& thread : m_threads) {
+        if (thread->m_isRunning && !thread->hasUnderlyingThread(locker)) {
+            thread->start(locker);
+            ++started;
+        }
+    }
+    return started;
+}
