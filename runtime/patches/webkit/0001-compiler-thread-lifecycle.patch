+void startCompilerThreads()
+{
+    // ensureGlobalWorklist() constructs the worklist and its AutomaticThread objects; the OS
+    // threads behind them are what startThreads() creates. Without the JIT there is nothing to
+    // compile, so building a worklist here would spawn threads that can never receive work.
+    if (Options::useJIT())
+        JITWorklist::ensureGlobalWorklist().startThreads();
+
+#if ENABLE(WEBASSEMBLY)
+    if (Wasm::isSupported())
+        Wasm::ensureWorklist().startThreads();
+#endif
+}
+
+void drainCompilerWorklists(VM& vm)
+{
+    // existingGlobalWorklistOrNull rather than ensureGlobalWorklist: a process
+    // that never compiled has nothing to drain and should not be made to build
+    // a worklist just to find that out.
+    if (auto* worklist = JITWorklist::existingGlobalWorklistOrNull())
+        worklist->completeAllPlansForVM(vm);
+
+#if ENABLE(WEBASSEMBLY)
+    if (auto* worklist = Wasm::existingWorklistOrNull())
+        worklist->stopAllPlansForContext(vm);
+#endif
+}
+
 } // namespace JSC
