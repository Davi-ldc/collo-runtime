+// Brings up every compiler thread the process will ever use — the JS tiers and, where built,
+// WebAssembly — without compiling anything. Each thread polls once, finds nothing, and parks.
+//
+// An embedder that installs a syscall filter denying thread creation must call this while creation
+// is still permitted, because after the filter the set of live threads is final: a compiler thread
+// born lazily by a later first-enqueue would abort the process instead. Pin the AutomaticThread
+// idle timeout first, or a thread may retire between this call and the filter.
+//
+// Idempotent, and safe to call when a worklist has no threads left to create.
+JS_EXPORT_PRIVATE void startCompilerThreads();
+
+class VM;
+
+// Blocks until no compilation is in flight for this VM. An embedder about to
+// fork needs this: a compiler thread only observes its idle timeout while it is
+// parked, so a plan still being compiled holds its thread indefinitely against
+// a caller waiting for the process to become single-threaded.
+JS_EXPORT_PRIVATE void drainCompilerWorklists(VM&);
+
 ALWAYS_INLINE void initialize(const Invocable<void()> auto& optionsCustomizationCallback)
 {
     SUPPRESS_FORWARD_DECL_ARG initializeWithOptionsCustomization(optionsCustomizationCallback);
