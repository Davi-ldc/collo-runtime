 static constexpr bool verbose = false;
+// A leaf lock: the idle loop takes it while holding a thread's m_lock, and nothing is taken while holding it.
+static Lock s_colloIdleOverridesLock;
+static std::optional<Seconds> s_colloTimeoutOverride WTF_GUARDED_BY_LOCK(s_colloIdleOverridesLock);
+static std::optional<Seconds> s_colloCacheReleaseOverride WTF_GUARDED_BY_LOCK(s_colloIdleOverridesLock);
+static Lock s_liveAutomaticThreadsLock;
+// JSC creates a small fixed set of AutomaticThreads in practice. A linear
+// remove is acceptable here; do not use this registry for short-lived pools.
+// Keep registry sections tiny, and never call into AutomaticThread while
+// holding s_liveAutomaticThreadsLock; registry lock must stay outside m_lock.
+struct ColloAutomaticThreadRegistryEntry {
+    AutomaticThread* thread;
+    ThreadSafeWeakPtr<AutomaticThread> weakThread;
+};
+static Vector<ColloAutomaticThreadRegistryEntry> s_liveAutomaticThreads;
+
+struct ColloIdlePolicy {
+    Seconds timeout;
+    std::optional<Seconds> cacheRelease;
+};
+
+// Without overrides each AutomaticThread keeps its upstream timeout and never releases its cache early.
+static ColloIdlePolicy colloIdlePolicy(Seconds defaultTimeout)
+{
+    Locker locker { s_colloIdleOverridesLock };
+    return { s_colloTimeoutOverride.value_or(defaultTimeout), s_colloCacheReleaseOverride };
+}
+
+static void wakeAutomaticThreadsForColloOverrideChange()
+{
+    // A thread already parked computed its deadline from the old values, so each waiting thread is woken to measure
+    // its current idle period against the new ones.
+    Vector<ThreadSafeWeakPtr<AutomaticThread>> liveThreads;
+    {
+        Locker locker { s_liveAutomaticThreadsLock };
+        liveThreads.reserveInitialCapacity(s_liveAutomaticThreads.size());
+        for (auto& entry : s_liveAutomaticThreads)
+            liveThreads.append(entry.weakThread);
+    }
+
+    for (auto& weakThread : liveThreads) {
+        RefPtr<AutomaticThread> automaticThread = weakThread.get();
+        if (!automaticThread)
+            continue;
+        automaticThread->wakeForColloOverrideChange();
+    }
+}
+
+void colloResetAutomaticThreadRegistry()
+{
+    Locker locker { s_liveAutomaticThreadsLock };
+    s_liveAutomaticThreads.clear();
+}
+
+void setColloAutomaticThreadTimeout(Seconds timeout)
+{
+    {
+        Locker locker { s_colloIdleOverridesLock };
+        s_colloTimeoutOverride = timeout;
+    }
+    wakeAutomaticThreadsForColloOverrideChange();
+}
+
+void setColloAutomaticThreadCacheRelease(Seconds idleTime)
+{
+    {
+        Locker locker { s_colloIdleOverridesLock };
+        s_colloCacheReleaseOverride = idleTime;
+    }
+    wakeAutomaticThreadsForColloOverrideChange();
+}
+
+void clearColloAutomaticThreadOverrides()
+{
+    {
+        Locker locker { s_colloIdleOverridesLock };
+        s_colloTimeoutOverride = std::nullopt;
+        s_colloCacheReleaseOverride = std::nullopt;
+    }
+    wakeAutomaticThreadsForColloOverrideChange();
+}
 
