 #include <wtf/PageBlock.h>
 #include <wtf/text/ParsingUtilities.h>
 #include <wtf/text/StringToIntegerConversion.h>
@@ -138,6 +140,48 @@ struct LinuxMemory {
     long pageSize { 0 };
     int statmFd { -1 };
 };
+
+struct ColloMemoryStatusOverride {
+    size_t limitBytes;
+    int memoryCurrentFd;
+};
+
+// Held across the read, so once clearColloMemoryStatusOverride returns no thread reads the descriptor again.
+static Lock s_colloMemoryStatusOverrideLock;
+static std::optional<ColloMemoryStatusOverride> s_colloMemoryStatusOverride WTF_GUARDED_BY_LOCK(s_colloMemoryStatusOverrideLock);
+
+void setColloMemoryStatusOverride(size_t limitBytes, int memoryCurrentFd)
+{
+    RELEASE_ASSERT(limitBytes);
+    RELEASE_ASSERT(memoryCurrentFd >= 0);
+    Locker locker { s_colloMemoryStatusOverrideLock };
+    s_colloMemoryStatusOverride = ColloMemoryStatusOverride { limitBytes, memoryCurrentFd };
+}
+
+void clearColloMemoryStatusOverride()
+{
+    Locker locker { s_colloMemoryStatusOverrideLock };
+    s_colloMemoryStatusOverride = std::nullopt;
+}
+
+// A cgroup v2 memory.current file holds one decimal byte count and a newline. A failed read or parse reports 0,
+// as LinuxMemory::footprint does when statm cannot be read.
+static std::optional<MemoryStatus> colloOverriddenMemoryStatus()
+{
+    Locker locker { s_colloMemoryStatusOverrideLock };
+    if (!s_colloMemoryStatusOverride)
+        return std::nullopt;
+
+    size_t memoryFootprint = 0;
+    std::array<char, 32> buffer;
+    ssize_t numBytes = pread(s_colloMemoryStatusOverride->memoryCurrentFd, buffer.data(), buffer.size(), 0);
+    if (numBytes > 0) {
+        auto parsingBuffer = spanReinterpretCast<const Latin1Character>(unsafeMakeSpan(buffer.data(), numBytes));
+        memoryFootprint = parseIntegerAllowingTrailingJunk<size_t>(parsingBuffer).value_or(0);
+    }
+    double percentInUse = static_cast<double>(memoryFootprint) / static_cast<double>(s_colloMemoryStatusOverride->limitBytes);
+    return MemoryStatus(memoryFootprint, std::min(percentInUse, 1.0));
+}
 #endif
 
 static size_t computeAvailableMemory()
@@ -208,6 +252,8 @@ MemoryStatus memoryStatus()
     if (KERN_SUCCESS == task_info(mach_task_self(), TASK_VM_INFO, (task_info_t)(&vmInfo), &vmSize))
         memoryFootprint = static_cast<size_t>(vmInfo.phys_footprint);
 #elif OS(LINUX)
+    if (auto overridden = colloOverriddenMemoryStatus())
+        return *overridden;
     auto& memory = LinuxMemory::singleton();
     size_t memoryFootprint = memory.footprint();
 #elif OS(FREEBSD)
