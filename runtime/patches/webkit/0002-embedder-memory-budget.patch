+// A process-local replacement for Options::gcMaxHeapSize(), for an embedder that forks and gives each child its own
+// memory budget after the fork. effectiveGCMaxHeapSize() returns the override when it is nonzero and the option
+// otherwise. With USE(BUN_JSC_ADDITIONS), Heap::collectIfNecessaryOrDefer requests a collection as soon as the bytes
+// allocated since the last one exceed it, and the heap's own trigger still runs below it.
+JS_EXPORT_PRIVATE void setColloGCMaxHeapSizeOverride(size_t);
+JS_EXPORT_PRIVATE void clearColloGCMaxHeapSizeOverride();
+JS_EXPORT_PRIVATE size_t effectiveGCMaxHeapSize();
+
 } // namespace JSC
