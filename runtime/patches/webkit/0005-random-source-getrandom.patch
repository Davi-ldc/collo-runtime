diff --git a/Source/WTF/wtf/CryptographicallyRandomNumber.cpp b/Source/WTF/wtf/CryptographicallyRandomNumber.cpp
index d203d901..322477ef 100644
--- a/Source/WTF/wtf/CryptographicallyRandomNumber.cpp
+++ b/Source/WTF/wtf/CryptographicallyRandomNumber.cpp
@@ -36,11 +36,36 @@
 #include <wtf/Lock.h>
 #include <wtf/NeverDestroyed.h>
 #include <wtf/OSRandomSource.h>
+#include <wtf/StdLibExtras.h>
 
 namespace WTF {
 
 namespace {
 
+#if OS(LINUX)
+// Every draw goes to the kernel. A generator that keeps its state in the process, like the ARC4 stream the other
+// platforms use, is copied into every child a fork or clone3 creates: sibling children would hand out the same
+// numbers until each one stirs again, and that stir reads the random device's descriptor, which a child may have
+// closed. The callers are cold (VM and global object creation, the start of each collection, UUIDs), so a system call
+// per draw costs little.
+class OSRandomNumberGenerator {
+public:
+    template<typename IntegerType>
+    IntegerType randomNumber()
+    {
+        IntegerType value { };
+        cryptographicallyRandomValuesFromOS(asMutableByteSpan(value));
+        return value;
+    }
+
+    void randomValues(std::span<uint8_t> buffer) { cryptographicallyRandomValuesFromOS(buffer); }
+};
+
+OSRandomNumberGenerator sharedRandomNumberGenerator()
+{
+    return { };
+}
+#else
 class ARC4Stream {
     WTF_DEPRECATED_MAKE_FAST_ALLOCATED(ARC4Stream);
 public:
@@ -151,6 +176,7 @@ ARC4RandomNumberGenerator& NODELETE sharedRandomNumberGenerator()
     static NeverDestroyed<ARC4RandomNumberGenerator> randomNumberGenerator;
     return randomNumberGenerator;
 }
+#endif
 
 }
 
