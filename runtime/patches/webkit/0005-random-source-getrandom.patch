 RandomDevice::~RandomDevice()
 {
     close(m_fd);
@@ -111,6 +120,24 @@ void RandomDevice::cryptographicallyRandomValues(std::span<uint8_t> buffer)
     RELEASE_ASSERT(!CCRandomGenerateBytes(buffer.data(), buffer.size()));
 #elif OS(FUCHSIA)
     zx_cprng_draw(buffer.data(), buffer.size());
+#elif OS(LINUX)
+    // getrandom keeps no descriptor in the process. A /dev/urandom descriptor opened once and kept is inherited by
+    // every child of a fork or clone3; a child that closes the descriptors it inherited hands that number to the next
+    // file it opens, the next read then comes from that file, and a sandboxed child cannot open /dev/urandom again.
+    // A signal can interrupt the call or shorten a large read, and any other failure means the kernel has no
+    // randomness to give.
+    size_t filled = 0;
+    while (filled < buffer.size()) {
+        auto remaining = buffer.subspan(filled);
+        ssize_t got = getrandom(remaining.data(), remaining.size(), 0);
+        if (got > 0) {
+            filled += static_cast<size_t>(got);
+            continue;
+        }
+        if (got < 0 && errno == EINTR)
+            continue;
+        crashUnableToGetRandom();
+    }
 #elif OS(UNIX)
     ssize_t amountRead = 0;
     while (static_cast<size_t>(amountRead) < buffer.size()) {
