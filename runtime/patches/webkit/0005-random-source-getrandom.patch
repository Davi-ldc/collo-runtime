diff --git a/Source/bmalloc/bmalloc/CryptoRandom.cpp b/Source/bmalloc/bmalloc/CryptoRandom.cpp
index 4724cad6..57d6a00f 100644
--- a/Source/bmalloc/bmalloc/CryptoRandom.cpp
+++ b/Source/bmalloc/bmalloc/CryptoRandom.cpp
@@ -48,8 +48,32 @@
 #include <CommonCrypto/CommonRandom.h>
 #endif
 
+#if BOS(LINUX)
+#include <sys/random.h>
+#endif
+
 namespace bmalloc {
 
+#if BOS(LINUX)
+// Every call goes to the kernel through getrandom, so the process keeps neither a /dev/urandom descriptor nor an
+// ARC4 stream. Both would be copied into every child of a fork or clone3: the children would share the stream, and
+// one that closes the descriptors it inherited would read its next stir from whatever file then holds the number.
+// A signal can interrupt the call or shorten a large read; any other failure means the kernel has no randomness to
+// give.
+void cryptoRandom(void* buffer, size_t length)
+{
+    unsigned char* bytes = static_cast<unsigned char*>(buffer);
+    size_t filled = 0;
+    while (filled < length) {
+        ssize_t got = getrandom(bytes + filled, length - filled, 0);
+        if (got > 0) {
+            filled += static_cast<size_t>(got);
+            continue;
+        }
+        RELEASE_BASSERT(got < 0 && errno == EINTR);
+    }
+}
+#else
 class ARC4Stream {
 public:
     ARC4Stream();
@@ -184,6 +208,7 @@ void cryptoRandom(void* buffer, size_t length)
 {
     ARC4RandomNumberGenerator::get()->randomValues(buffer, length);
 }
+#endif
 
 } // namespace bmalloc
 
