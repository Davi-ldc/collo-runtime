+            // skips is the fully-active-document rule, which no JSC-only embedder
+            // can fail; enqueue still routes through enqueueSlow and still notifies
+            // the debugger.
+            uint64_t ownerToken = reaction->colloOwnerToken();
+            if (ownerToken && ownerToken != runningOwnerToken) [[unlikely]] {
+                RefPtr<MicrotaskDispatcher> owned;
+                if (g_colloOwnerDispatcherFactory)
