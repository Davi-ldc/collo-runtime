index 6c0d25cb..0396af35 100644
--- a/Source/JavaScriptCore/runtime/JSPromise.h
+++ b/Source/JavaScriptCore/runtime/JSPromise.h
@@ -37,6 +37,7 @@ namespace JSC {
 
 class JSPromiseConstructor;
 class JSPromiseReaction;
+class MicrotaskDispatcher;
 
 // JSPromise stores its state in two machine words:
 //   m_packed: CompactPointerTuple<JSCell*, uint16_t>
@@ -297,6 +298,30 @@ JSC_DECLARE_HOST_FUNCTION(promiseResolvingFunctionResolveWithInternalMicrotask);
 JSC_DECLARE_HOST_FUNCTION(promiseResolvingFunctionRejectWithInternalMicrotask);
 JSC_DECLARE_HOST_FUNCTION(promiseCapabilityExecutor);
 
+// A promise reaction belongs to the execution context that REGISTERED it, which
+// is not always the one running when it becomes runnable: `await p` in request A
+// registers a reaction that request B makes runnable by settling p, and JSC runs
+// it inside B's turn. The token is minted by the embedder and opaque here; 0
+// means the embedder could not name an owner at all, which leaves the reaction
+// running under whoever the queue supplies -- the behaviour from before this
+// existed. An embedder with no owner to name is expected to mint a token for
+// that state rather than answer 0, so that work outside any turn stays outside
+// it instead of inheriting a live one.
+//
+// One reading serves both uses: a reaction records who is running when it is
+// registered, and a settle compares against who is running then. Comparing
+// against the owner of the enclosing TURN instead would be wrong, because the
+// equal case falls through to the plain enqueue, and inside a restored
+// continuation that path stamps the ambient owner -- so a reaction belonging to
+// the outer turn would be re-tagged as the restored one.
+//
+// Hooks unset => every operation here is a no-op, so an embedder that does not
+// opt in pays one null check per promise reaction.
+using ColloOwnerTokenGetter = uint64_t (*)(JSGlobalObject*);
+using ColloOwnerDispatcherFactory = RefPtr<MicrotaskDispatcher> (*)(VM&, JSGlobalObject*, uint64_t ownerToken);
+JS_EXPORT_PRIVATE void colloSetOwnerHooks(ColloOwnerTokenGetter, ColloOwnerDispatcherFactory);
+JS_EXPORT_PRIVATE uint64_t colloCurrentOwnerToken(JSGlobalObject*);
+
 JSObject* promiseSpeciesConstructor(JSGlobalObject*, JSObject*);
 Structure* createPromiseCapabilityObjectStructure(VM&, JSGlobalObject&);
 bool isDefinitelyNonThenable(JSObject*, JSGlobalObject*);
