+    uint64_t runningOwnerToken = colloCurrentOwnerToken(globalObject);
 
     auto queue = [&](JSPromiseReaction* reaction) ALWAYS_INLINE_LAMBDA {
+        auto enqueue = [&](QueuedTask&& queuedTask) {
+            // A reaction whose owner is not the one running has to carry that owner
+            // itself, and the enqueue goes straight to the queue rather than through
+            // queueMicrotask: inside a restored continuation the latter stamps the
+            // AMBIENT owner over whatever this task decided, which would re-tag the
