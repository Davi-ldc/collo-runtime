+// Process-global: the embedder installs these once, before any JS runs, and every
+// VM resolves its own owner from the global object it is handed.
+static ColloOwnerTokenGetter g_colloCurrentOwnerToken { nullptr };
+static ColloOwnerDispatcherFactory g_colloOwnerDispatcherFactory { nullptr };
+
+void colloSetOwnerHooks(ColloOwnerTokenGetter getter, ColloOwnerDispatcherFactory factory)
+{
+    g_colloCurrentOwnerToken = getter;
+    g_colloOwnerDispatcherFactory = factory;
+}
+
+uint64_t colloCurrentOwnerToken(JSGlobalObject* globalObject)
+{
+    if (!g_colloCurrentOwnerToken)
+        return 0;
+    return g_colloCurrentOwnerToken(globalObject);
+}
