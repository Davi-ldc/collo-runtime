// The X-macro table of ColloWebApiCache's VM-lifetime roots; the ColloWebApiCache comment in state.h says what a
// GETTER row and a FIELD row generate. It has no include guard on purpose: state.h and webapi_cache.cpp each include
// it twice, with different COLLO_WEBAPI_CACHE_* definitions.
//
// ColloWebApiCache::clear empties every row, but a row holds a value only where code stores it, so a new GETTER row
// needs a store in the code that installs its API, usually a GlobalObject::cache*Api setter, before its accessor can
// be called.
COLLO_WEBAPI_CACHE_GETTER(urlConstructor, url_constructor, JSC::JSObject)
COLLO_WEBAPI_CACHE_GETTER(urlPrototype, url_prototype, JSC::JSObject)
COLLO_WEBAPI_CACHE_GETTER(urlStructure, url_structure, JSC::Structure)
COLLO_WEBAPI_CACHE_GETTER(urlSearchParamsConstructor, url_search_params_constructor, JSC::JSObject)
COLLO_WEBAPI_CACHE_GETTER(urlSearchParamsPrototype, url_search_params_prototype, JSC::JSObject)
COLLO_WEBAPI_CACHE_GETTER(urlSearchParamsStructure, url_search_params_structure, JSC::Structure)
COLLO_WEBAPI_CACHE_GETTER(urlSearchParamsIteratorPrototype, url_search_params_iterator_prototype, JSC::JSObject)
COLLO_WEBAPI_CACHE_GETTER(urlSearchParamsIteratorStructure, url_search_params_iterator_structure, JSC::Structure)
COLLO_WEBAPI_CACHE_FIELD(url_pattern_constructor, JSC::JSObject)
COLLO_WEBAPI_CACHE_FIELD(url_pattern_prototype, JSC::JSObject)
COLLO_WEBAPI_CACHE_FIELD(url_pattern_structure, JSC::Structure)

