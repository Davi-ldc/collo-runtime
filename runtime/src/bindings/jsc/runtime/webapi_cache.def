// The X-macro table of ColloWebApiCache's VM-lifetime roots; the ColloWebApiCache comment in state.h says what a
// GETTER row and a FIELD row generate. It has no include guard on purpose: state.h and webapi_cache.cpp each include
// it twice, with different COLLO_WEBAPI_CACHE_* definitions.
//
// ColloWebApiCache::clear empties every row, but a row holds a value only where code stores it, so a new GETTER row
// needs a store in the code that installs its API, a GlobalObject::cache*Api setter or the installer itself, before
// its accessor can be called.
COLLO_WEBAPI_CACHE_GETTER(urlConstructor, url_constructor, JSC::JSObject)
COLLO_WEBAPI_CACHE_GETTER(urlPrototype, url_prototype, JSC::JSObject)
COLLO_WEBAPI_CACHE_GETTER(urlStructure, url_structure, JSC::Structure)
COLLO_WEBAPI_CACHE_GETTER(urlSearchParamsConstructor, url_search_params_constructor, JSC::JSObject)
COLLO_WEBAPI_CACHE_GETTER(urlSearchParamsPrototype, url_search_params_prototype, JSC::JSObject)
COLLO_WEBAPI_CACHE_GETTER(urlSearchParamsStructure, url_search_params_structure, JSC::Structure)
COLLO_WEBAPI_CACHE_GETTER(urlSearchParamsIteratorPrototype, url_search_params_iterator_prototype, JSC::JSObject)
COLLO_WEBAPI_CACHE_GETTER(urlSearchParamsIteratorStructure, url_search_params_iterator_structure, JSC::Structure)
COLLO_WEBAPI_CACHE_FIELD(url_pattern_constructor, JSC::JSObject)
COLLO_WEBAPI_CACHE_FIELD(url_pattern_prototype, JSC::JSObject)
COLLO_WEBAPI_CACHE_FIELD(url_pattern_structure, JSC::Structure)

COLLO_WEBAPI_CACHE_GETTER(headersConstructor, headers_constructor, JSC::JSObject)
COLLO_WEBAPI_CACHE_GETTER(headersPrototype, headers_prototype, JSC::JSObject)
COLLO_WEBAPI_CACHE_GETTER(headersStructure, headers_structure, JSC::Structure)
COLLO_WEBAPI_CACHE_GETTER(headersIteratorPrototype, headers_iterator_prototype, JSC::JSObject)
COLLO_WEBAPI_CACHE_GETTER(headersIteratorStructure, headers_iterator_structure, JSC::Structure)

COLLO_WEBAPI_CACHE_GETTER(requestConstructor, request_constructor, JSC::JSObject)
COLLO_WEBAPI_CACHE_GETTER(requestPrototype, request_prototype, JSC::JSObject)
COLLO_WEBAPI_CACHE_GETTER(requestStructure, request_structure, JSC::Structure)

COLLO_WEBAPI_CACHE_GETTER(responseConstructor, response_constructor, JSC::JSObject)
COLLO_WEBAPI_CACHE_GETTER(responsePrototype, response_prototype, JSC::JSObject)
COLLO_WEBAPI_CACHE_GETTER(responseStructure, response_structure, JSC::Structure)

// The stream classes keep only the structures their instances and internal cells are built from; the global object's
// properties keep their constructors and prototypes alive.
COLLO_WEBAPI_CACHE_GETTER(readableStreamStructure, readable_stream_structure, JSC::Structure)
COLLO_WEBAPI_CACHE_GETTER(readableStreamDefaultReaderStructure, readable_stream_default_reader_structure, JSC::Structure)
